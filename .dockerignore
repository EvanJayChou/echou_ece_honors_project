# Keep the build context small; the image only needs the ROS sources and scripts.
**/.git
.vscode/
**/build/
**/install/
**/log/
**/__pycache__/
*.pyc
docs/
maps/
*.pdf
# Personal overrides and editor config: not needed in the image, and changing
# them shouldn't invalidate the source layer.
docker/.env
.devcontainer/
