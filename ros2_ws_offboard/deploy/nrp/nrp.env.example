# NRP (Nautilus) settings for offline 3DGS retrains. The ONE place to configure NRP.
#
#   cp ros2_ws_offboard/deploy/nrp/nrp.env.example ros2_ws_offboard/deploy/nrp/nrp.env
#   # edit nrp.env (git-ignored), then:
#   scripts/nrp_retrain.sh <run_id> --heldout <heldout_run_id> --dry-run
#
# Use a different file with NRP_ENV=/path/to/file scripts/nrp_retrain.sh ...
# Per-run values (run ID, held-out ID, seed count) are command-line arguments, not set here.
#
# Not configurable on purpose (conditions of our A100 access, see docs/3dgs_design.md §6.2):
# no `sleep`, Job pods only, and every pod is killed after 1 hour. The script refuses to
# submit a manifest that breaks these rules.

# ── Cluster ─────────────────────────────────────────────────────────────────────
# Your NRP namespace (required).
NRP_NAMESPACE=
# kubeconfig context for NRP; leave empty to use the current context.
NRP_KUBE_CONTEXT=

# ── Container image ─────────────────────────────────────────────────────────────
# Retrain image (ros2_ws_offboard/docker/Dockerfile.retrain). Pin by digest
# (…@sha256:…) so every benchmark retrain runs identical code (required).
NRP_IMAGE=

# ── Storage ─────────────────────────────────────────────────────────────────────
# PersistentVolumeClaim holding runs/ and results/ (required). It is mounted at /data:
#   /data/runs/<run_id>/       run packages (from `gs-explore export`)
#   /data/results/<run_id>/    retrain outputs
NRP_PVC=

# ── GPU ─────────────────────────────────────────────────────────────────────────
# Resource name. A100s on NRP are a special resource, not nvidia.com/gpu.
NRP_GPU_RESOURCE=nvidia.com/a100
# Node label value to pin ONE GPU model for every benchmark retrain (required).
# List them with: kubectl get nodes -L nvidia.com/gpu.product
NRP_GPU_PRODUCT=

# ── Per-pod resources ───────────────────────────────────────────────────────────
# Limits are set equal to requests (NRP wants limits within 20% of requests).
NRP_CPU=4
NRP_MEMORY=24Gi

# ── Job ─────────────────────────────────────────────────────────────────────────
# Training seeds per run (one pod each). Override per submission with --seeds.
NRP_NUM_SEEDS=3
# Deadline for the whole Job including retries, in seconds. Each pod is still capped at 1 h.
NRP_JOB_DEADLINE_S=10800
# Offline config, relative to the repo root. Its sha256 names the ConfigMap, so a
# running Job never sees a config edited after submission.
NRP_CONFIG=ros2_ws_offboard/src/gs_explore/config/offline.yaml
