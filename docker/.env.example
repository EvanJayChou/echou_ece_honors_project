# Optional overrides for docker/compose.yaml and docker/dev.sh.
# Everything works without this file; copy it to docker/.env (git-ignored) only
# if a default below is wrong for you:
#   cp docker/.env.example docker/.env
#
# Your host user and group IDs. Run `id -u` and `id -g` on the host. If either
# isn't 1000, set them here and rebuild the image (docker compose -f
# docker/compose.yaml build), then run docker/dev.sh reset-home.
#USER_UID=1000
#USER_GID=1000

# GID of the host's `render` group, which the dev container needs for the GPU
# (default 993). Check with: getent group render | cut -d: -f3
# No rebuild needed; docker/dev.sh up applies it.
#RENDER_GID=993

# ROS 2 domain for the dev container (default 42). Pick one no one else on this
# Jetson or network uses; machines that should talk to each other share it.
#ROS_DOMAIN_ID=42
